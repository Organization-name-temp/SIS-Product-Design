{
  "$description": "SIS typography tokens. W3C design tokens format. Decision provenance, rules, and number formatting live under $extensions.",
  "$extensions": {
    "sis.provenance": {
      "metadata": {
        "date": "2026-10-27",
        "status": "Approved active profile: IBM Plex Sans Arabic for Arabic and English",
        "scaleApprovedOn": "2026-10-27",
        "updatedOn": "2026-10-28"
      },
      "fontCandidates": {
        "ibm": {
          "family": "IBM Plex Sans Arabic",
          "status": "selected",
          "source": "https://github.com/google/fonts/tree/main/ofl/ibmplexsansarabic"
        }
      },
      "selectedFont": "ibm",
      "openDecisions": [],
      "finalPrototype": {
        "fontSelector": [
          "ibm"
        ],
        "themes": [
          "light",
          "dark"
        ],
        "languages": [
          "ar",
          "en"
        ],
        "comparisonRule": "Use IBM Plex Sans Arabic in every role. Compare the four approved weights with identical content.",
        "samples": {
          "ar": "التسجيل في الجامعة وإدارة المقررات الدراسية",
          "en": "University registration and course management",
          "mixed": "CS101 · أحمد Hassan · Émilie François",
          "digits": "0123456789 · 1,250.50 · 3.75"
        },
        "checks": [
          "Arabic shaping and diacritics",
          "French accents",
          "mixed-direction content",
          "number distinction and alignment",
          "small labels and table values",
          "heading hierarchy",
          "zoom and text expansion",
          "font load success before comparison"
        ]
      },
      "rules": [
        "Same typography in light and dark themes",
        "14px reference minimum for standard interface text",
        "Compact density reduces surrounding spacing, not text size",
        "Relative units follow browser preferences; px values assume a 16px root",
        "No forced uppercase or added Arabic tracking",
        "Weight 700 is reserved for limited emphasis"
      ],
      "numberFormatting": {
        "numberingSystem": "latn",
        "allInterfaceLanguages": true,
        "localizedSeparators": true,
        "formatIdentifiers": false,
        "status": "approved"
      }
    },
    "sis.letterSpacingStatus": "approved starting value; final visual check pending"
  },
  "ref": {
    "font": {
      "family": {
        "ibm": {
          "$type": "fontFamily",
          "$value": "IBM Plex Sans Arabic"
        }
      }
    }
  },
